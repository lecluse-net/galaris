API_HOST=127.0.0.1
API_PORT=8485

# Optional IP allowed to call the API in addition to localhost. Empty disables IP filtering.
# Keep the listener private and restrict access with your firewall; authentication is always required.
ALLOWED_IP=

# Fernet key shared by this server and the Galaris client.
# Generated by `make install`; the client must use the same value.
# Usage:
#   - Authentication: the client encrypts a nonce and sends it in X-Harness-Token.
#   - Files: file content is encrypted and decrypted with the same key.
HARNESS_MANAGER_SECRET=

# Absolute path to the root containing harness instance directories.
BASE_DIR=/opt/galaris-harnesses

# Comma-separated BASE_DIR children that the manager must never access.
IGNORE_DIRS=

# Legacy MiB storage unit; this value is exactly 1 decimal MB.
MAX_FILE_SIZE_MB=0.95367431640625

# Legacy MiB storage unit; this value is exactly 512 decimal MB.
# Enforced even without Content-Length.
MAX_RAW_FILE_SIZE_MB=488.28125

# Galaris update endpoint, supplied by the installation ZIP. Prefer HTTPS remotely.
# Override once with: make update UPDATE_URL=https://galaris.example/api/harness-manager/updates
GALARIS_UPDATE_URL=
