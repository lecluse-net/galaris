{
    "compilerOptions": {
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        /* Validate build configuration with the same strictness as the application. */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true
    },
    "include": [
        "vite.config.ts"
    ]
}