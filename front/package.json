{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run lint && vite build && node scripts/report-build.mjs",
    "preview": "vite preview",
    "test": "node --test",
    "test:tooling": "node --test scripts/typecheck-gate.check.mjs",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "i18n-check": "node scripts/check-i18n.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-vue": "^8.2.0",
    "@quasar/extras": "~2.0.3",
    "axios": "^1.18.1",
    "ckeditor5": "^48.5.0",
    "dompurify": "^3.2.0",
    "echarts": "^6.1.0",
    "highlight.js": "11.12.0",
    "jwt-decode": "^4.0",
    "marked": "^18.0.9",
    "pinia": "~4.0.3",
    "qrcode": "^1.5.4",
    "quasar": "^2.24.0",
    "socket.io-client": "^4.8",
    "three": "^0.185.1",
    "vue": "~3.5.41",
    "vue-i18n": "^11.4",
    "vue-router": "~5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@quasar/vite-plugin": "~2.0.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "~6.0",
    "eslint": "~10.10.0",
    "eslint-plugin-vue": "~10.11.0",
    "sass": "^1.101.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.69.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "~3.3.10"
  }
}
