{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run lint && vite build && node scripts/report-build.mjs",
    "preview": "vite preview",
    "test": "node --test",
    "test:tooling": "node --test scripts/typecheck-gate.check.mjs",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "i18n-check": "node scripts/check-i18n.mjs",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@quasar/extras": "~2.1.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "highlight.js": "11.12.0",
    "jwt-decode": "^4.0.0",
    "marked": "^18.1.1",
    "pinia": "~4.1.0",
    "qrcode": "^1.5.4",
    "quasar": "^2.35.2",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "vue": "~3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "~5.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@eslint/js": "~10.0.1",
    "@quasar/vite-plugin": "~2.0.2",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "~6.0.10",
    "eslint": "~10.13.0",
    "eslint-plugin-vue": "~10.11.1",
    "sass": "^1.106.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vue-tsc": "3.3.11"
  }
}
