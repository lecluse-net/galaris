# Setup: make install -> customize .env and compose.override.yaml -> make start.
# Complete reference for supported deployment settings in the root .env.
# Set APP_HOST; uncomment optional settings only to override their defaults.
# Generated values are filled by make install/update. PostgreSQL is included by default.
# Runtime preferences belong in the UI, not here. Service-internal environment
# variables and temporary build/test command arguments are not .env settings.

# =========== GLOBAL Application Settings ===========
APP_NAME=galaris
# Public origin used by browsers and external harness runtimes. It must be
# reachable from every machine that runs a managed agent container.
# make install sets the localhost port; use the public URL for remote access.
APP_HOST=http://localhost:8484
# Free environment label (examples: dev, test, pp, demo, prod). Default: prod.
# Only dev enables development; all other editions use production behavior.
# The edition also identifies the application through its menu banner.
APP_ENV=prod

# Timezone setting (e.g., "UTC", "Europe/Paris", "America/New_York")
TZ=UTC

# Optional extra HTTP Host names/IPs (comma-separated, without scheme or port).
# Automatically allowed: localhost, 127.0.0.1, backend, <APP_NAME>-back,
# <APP_NAME>-front, APP_HOST and the runtime API hostname configured in Preferences.
# Empty is normally sufficient. Explicit "*" accepts every host, including in prod.
# This does not change CORS, whose allowed origin is APP_HOST.
#BACK_ALLOWED_HOSTS=

# `embedded` adds compose.turn.yaml by default and derives the public
# TURN name from APP_HOST. Use `external` with explicit ICE URLs to reuse an
# existing coturn, or `disabled` to hide browser audio calls in production.
# Allowed: embedded, external, disabled.
#WEBRTC_TURN_MODE=embedded
#WEBRTC_ICE_URLS=
# Browser TURN hostname. "auto" derives it from APP_HOST.
#WEBRTC_TURN_HOST=auto
#WEBRTC_TURN_PORT=3479
#WEBRTC_TURN_MIN_PORT=47000
#WEBRTC_TURN_MAX_PORT=47100
#WEBRTC_TURN_RELAY_IP=auto
# Generated from WEBRTC_TURN_RELAY_IP by bin/update-secrets.sh. Embedded mode
# also exposes this address to browsers as a direct LAN fallback.
#WEBRTC_TURN_RELAY_IP_RESOLVED=
# Generated shared credential for the backend and coturn; keep its generated value.
#WEBRTC_TURN_SHARED_SECRET=
#WEBRTC_TURN_TTL_SECONDS=3600
#WEBRTC_TURN_IMAGE=coturn/coturn:4.17.2-r0
#WEBRTC_TURN_CPUS=1.0
#WEBRTC_TURN_MEMORY_LIMIT=512m

# Master key for encrypting connection passwords (Fernet format)
# Generated automatically by make install/update.
# WARNING: NEVER change, delete or regenerate this key after installation.
# Losing the original key makes existing encrypted data unrecoverable. Back it up.
ENCRYPTION_MASTER_KEY=

# --- Logging and process health ---
# Allowed: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
# Optional Logfire export is configured in Preferences > System.

# --- Development settings ---
# make install records the current host user's UID automatically.
#DEV_HOST_USER_ID=1000

# External port mapped to debugpy (container port stays 5678)
# Don't forget to adapt .vscode/launch.json debugpy config port
#DEV_DEBUGPY_PORT=5678

# --- Database ---
# embedded includes compose.postgres.yaml (default); external uses an existing database.
# With external, configure POSTGRES_HOST, PORT, DB, USER and PASSWORD below.
# Allowed: embedded, external.
# make install records the chosen mode automatically.
POSTGRES_MODE=embedded
POSTGRES_DB=galaris
POSTGRES_HOST=postgres
# Generated for the embedded database; set the existing password for an external one.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_USER=galaris

# --- Database pool and timeouts ---
# Connection capacity = DB_POOL_SIZE + DB_MAX_OVERFLOW.
#DB_POOL_SIZE=20
#DB_MAX_OVERFLOW=20
# Pool acquisition timeout and connection recycling interval, in seconds.
#DB_POOL_TIMEOUT=30
#DB_POOL_RECYCLE=1800
# Allowed: true, false. Useful for stale connections to remote databases.
#DB_POOL_PRE_PING=true
# Individual SQL statements and lock waits are bounded, not whole agent runs.
#DB_STATEMENT_TIMEOUT_MS=120000
#DB_LOCK_TIMEOUT_MS=10000
# Atlas and target materialization have a separate, longer deadline.
#DBADMIN_COMMAND_TIMEOUT_SECONDS=600

# --- Container resource limits ---
# Docker CPU quotas and memory limits; changes require recreating the container.
# Browser session, content and capture limits are configured in Preferences > Browser.
#BROWSER_EXECUTOR_CPUS=2.0
#BROWSER_EXECUTOR_MEMORY_LIMIT=2g
#SSH_EXECUTOR_CPUS=4.0
#SSH_EXECUTOR_MEMORY_LIMIT=8g
