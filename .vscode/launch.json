{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Attach to Backend (Docker)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/back",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": false,
            "subProcess": true
        }
    ]
}