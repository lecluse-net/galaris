# Customize host ports, volume mounts and networks here.
# Application settings belong in .env.
services:
  # make install selects the host port; the container port remains 8484.
  frontend:
    ports:
      - "8484:8484"

  backend:
    volumes:
      - galaris_data:/data
      # Optional dedicated file disk. Prepare the existing host directory first;
      # mount it before the first upgrade that migrates internal attachments.
      # - type: bind
      #   source: /mnt/galaris-files
      #   target: /data/files
      #   bind:
      #     create_host_path: false

  ssh-executor:
    volumes:
      - galaris_data:/data

volumes:
  galaris_data:
    name: ${APP_NAME:-galaris}_data
